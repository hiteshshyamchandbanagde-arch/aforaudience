generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ARTIST
  ORGANISER
  VENUE_OWNER
  AUDIENCE
  ADMIN
}

enum EventType {
  OPEN_MIC
  STAND_UP
  POETRY
  THEATER
  LINEUP
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CANCELLED
  COMPLETED
}

// FEAT-2608-045 (11 Aug) - organiser-authored "special notes" on an event
// go through admin review before they're shown publicly, same shape as
// GenreRequestStatus but with a required rejection reason (Hitesh:
// "reject with reason make sense") and a NONE state so an event with no
// notes at all doesn't show up as a pending review item.
enum EventNoteStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  // Applied when the event's lineup (Event.maxPerformers) was already
  // full at application time - a real queue instead of a hard rejection.
  // FCFS by createdAt. Promotion to APPROVED on a cancellation isn't
  // wired up yet (no cancellation mechanism exists in the app at all -
  // separate gap, see design.md 9.4) - this ships the queue itself first.
  WAITLISTED
}

// --- §4.5 Venue & Event Economics Model additions (additive only - no
// existing fields removed or renamed, so nothing currently live breaks) ---

enum RateType {
  HOURLY
  DAILY
  FLEXIBLE
}

// §9.4 twenty-fourth amendment - opt-in numbered seating per venue.
enum VenueSeatingMode {
  GENERAL_ADMISSION
  NUMBERED
}

// §9.4 seat-map cluster item #6 (batch decision, 31 Jul session 48) -
// safety/reference markers, scoped as potentially Fire-NOC-relevant.
// STAGE_DISTANCE_REF doesn't auto-measure (no real-world scale
// calibration exists for the canvas) - it's a placed reference point
// paired with a manually-entered distanceMeters figure, e.g. "12m to
// rear exit", for the owner's own compliance documentation.
enum VenueMarkerType {
  GATE
  FIRE_EXTINGUISHER
  STAGE_DISTANCE_REF
}

enum CompensationType {
  PAID
  FREE
  BUY_IN
}

enum ApprovalMode {
  MANUAL
  AUTO
}

// Tour by Organiser (12 Aug, "as a collaborator" session). Distinct from
// the pre-existing ArtistTourStop (self-reported, informational only,
// FEAT-2608-047) - a Tour is Organiser-owned, wraps real bookable Events,
// and every fixed-lineup artist across it must consent before any stop
// goes live. Single- or multi-artist. DRAFT while the organiser is still
// adding stops/lineup; PENDING_CONSENT once at least one artist has an
// outstanding invite; LIVE once every currently-listed artist has
// accepted. Individual stops can still go live incrementally: a stop's
// own publish gate checks only ITS OWN Performance.artistIds against
// TourArtistConsent (computed at request time, no separate stored flag),
// so one artist's outstanding invite on a different stop doesn't block
// this one. CANCELLED/COMPLETED are terminal.
enum TourStatus {
  DRAFT
  PENDING_CONSENT
  LIVE
  CANCELLED
  COMPLETED
}

enum EventCategory {
  STANDALONE
  TOUR_STOP
}

model Tour {
  id           String     @id @default(cuid())
  organiserId  String
  organiser    Organiser  @relation(fields: [organiserId], references: [id])
  title        String
  subject      String?
  slug         String     @unique
  status       TourStatus @default(DRAFT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  stops        Event[]
  consents     TourArtistConsent[]

  @@index([organiserId])
}

// One consent record per artist per Tour (not per stop) - an artist
// listed across several stops only has to respond once. A DECLINE lets
// the organiser drop that artist from their stop(s) and re-invite a
// replacement without blocking other artists' already-accepted stops.
// Reuses InviteStatus (same shape as EventPanelist/Celebrity Accept-to-
// Appear) rather than a bespoke enum, per existing convention.
model TourArtistConsent {
  id        String        @id @default(cuid())
  tourId    String
  tour      Tour          @relation(fields: [tourId], references: [id])
  artistId  String
  artist    Artist        @relation(fields: [artistId], references: [id])
  status    InviteStatus  @default(PENDING)
  respondedAt DateTime?
  createdAt DateTime      @default(now())

  @@unique([tourId, artistId])
  @@index([artistId])
}

enum VenueBookingRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum OfferProposedBy {
  ORGANISER
  VENUE_OWNER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Checkpoint 2 — Razorpay payment lifecycle.
// See prisma/migrations/20260713000000_checkpoint_2_payments/migration.sql
// for the reasoning behind each state.
enum PaymentStatus {
  CREATED            // Razorpay order created; user hasn't paid yet
  VERIFIED           // Frontend signature verified; booking marked CONFIRMED
  WEBHOOK_CONFIRMED  // Webhook also confirmed; safety net check passed
  FAILED             // Payment failed at Razorpay
  MISMATCH           // Frontend + webhook disagree; needs human review
}

// Optional per-day override on top of Venue.hourlyRate/dailyRate - a row
// here only exists for days the owner explicitly priced differently (e.g.
// a weekend premium). A day with no row here just uses the venue's base
// rate. Doesn't apply to FLEXIBLE-rate venues, since those are negotiated
// per request anyway via VenueBookingRequest/VenueBookingOffer.
model VenueDayRate {
  id         String    @id @default(cuid())
  venueId    String
  venue      Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  dayOfWeek  DayOfWeek
  hourlyRate Float?
  dailyRate  Float?

  @@unique([venueId, dayOfWeek])
}


// In-app messaging (Hitesh request, 26 Jul session 36; design.md §9.4).
// One generic shape for every confirmed-relationship thread instead of
// three near-identical tables - contextType/contextId is a loose
// reference (not an FK, since it points at a different table depending
// on type), same "plain scalar, not a relation" pattern already used
// for checkedInByUserId/suspendedByUserId elsewhere in this schema.
//   PERFORMANCE   -> Artist <-> Organiser, one thread per lineup slot
//   VENUE_BOOKING -> Organiser <-> Venue Owner, one thread per confirmed booking
//   BOOKING       -> Audience <-> Organiser, one thread per ticket (per-booking
//                    granularity, Hitesh's call 26 Jul - not shared per-event)
// ConversationParticipant is a real join table (not a hardcoded 2-party
// shape) deliberately, so a future group thread needs no schema change.
enum ConversationContextType {
  PERFORMANCE
  VENUE_BOOKING
  BOOKING
}

model Conversation {
  id          String                  @id @default(cuid())
  contextType ConversationContextType
  contextId   String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@unique([contextType, contextId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null until the participant opens the thread at least once. Compared
  // against the newest Message.createdAt to compute an unread badge - no
  // per-message read-receipt model (v1 explicitly defers read receipts,
  // design.md §9.4).
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model User {
  id          String   @id @default(cuid())
  name        String   @unique // also doubles as the login "username"
  // Optional human-readable display name. `name` is the login username
  // (3-20 chars, [a-zA-Z0-9_]) — historically we also displayed `name`
  // to the user, which meant tickets/emails showed a squished-together
  // lowercase string. `displayName` is where the register form's
  // "Full Name" now lands, and every user-facing surface reads
  // `displayName ?? name`. Existing users have null and can set theirs
  // from Profile.
  displayName String?
  email       String   @unique
  phone       String?
  password    String
  role        Role     @default(AUDIENCE)
  avatar      String?
  // Optional "About You" text (session 62, design.md §9.5). Applies to any
  // role but primarily targets Audience, which has no dedicated child
  // profile table of its own (unlike Artist/Organiser/VenueOwner) — their
  // name+photo already surface publicly in ratings/feedback today, so this
  // closes that gap. Deliberately optional/never required at signup.
  bio         String?
  isVerified  Boolean  @default(false)
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Display-only currency preference (approved 25 Jul, built 30 Jul,
  // session 47 - "Option A" from design.md §9). ISO 4217 code, e.g.
  // "USD"/"EUR"/"GBP"/"AED". Null means India/₹ default - the vast
  // majority of users, so this stays unset rather than every existing
  // row needing a backfill. Purely cosmetic: real settlement is ALWAYS
  // INR regardless of this value (Real multi-currency settlement,
  // "Option B", is explicitly out of scope and blocked by the freeze -
  // see design.md). Validated server-side against DisplayCurrencyRate's
  // known codes, not a free string.
  displayCurrency String?

  // FEAT-2608-036 (2 Aug) - default-location preference for Events/Venues
  // search. Same pattern as displayCurrency above: null means "no explicit
  // choice yet", in which case the app falls back to a cookie-stored guess
  // (see src/lib/location.ts) derived from Vercel's IP geolocation headers
  // - never written here automatically. Only set once the user actively
  // picks a city via the header location chip, so this column reflects a
  // real preference, not a silent auto-detected guess getting persisted
  // on every anonymous session that happens to log in.
  defaultCity    String?
  defaultCityLat Float?
  defaultCityLng Float?
  // FEAT-2608-036 follow-up (2 Aug) - country of the chosen city, full
  // name matching Venue.country's format (e.g. "India"), so the header
  // chip can render "Pune (IN)" via src/lib/country-codes.ts. Only set
  // together with defaultCity when the user picks from the city list
  // (which already knows each city's country) - never guessed.
  defaultCountry String?

  // H3 — moderation. suspendedByUserId is a plain scalar (not a relation),
  // same pattern as Booking.checkedInByUserId - who did it matters for the
  // admin's own record, doesn't need a join for anything the app does.
  // Suspension blocks login (auth.ts) and invalidates any live session
  // immediately (session callback, same mechanism as the B5 password-reset
  // check) rather than waiting out the JWT's 7-day life. Deliberately does
  // NOT cascade-cancel existing confirmed bookings or events already sold -
  // an audience member who already paid for a ticket to a since-suspended
  // Organiser's event isn't part of the reason for the suspension and
  // shouldn't be stranded. It DOES hide that Organiser/Venue Owner's
  // future events/venues from public listings (see events & venues GET
  // routes) so no new tickets get sold while under suspension. Reversible:
  // unsuspend just clears these fields, no separate "banned" state.
  isSuspended       Boolean   @default(false)
  suspendedAt       DateTime?
  suspendReason     String?
  suspendedByUserId String?

  // Universal login code, format AFA<YYMM><6-digit seq>. Generated by a DB
  // trigger on insert (see migration) — every user gets one regardless of
  // role, so "log in with code" works for Audience too, not just
  // Artist/Organiser/Venue Owner (which additionally get their own
  // role-specific code below).
  code String? @unique

  // B6 — rate limiting / account lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // B5 — bumped on every successful password reset so existing JWT
  // sessions (which carry the tokenVersion at time of issue) stop
  // validating in the NextAuth session callback.
  tokenVersion Int @default(0)

  artist                Artist?
  organiser              Organiser?
  venueOwner             VenueOwner?
  bookings               Booking[]
  reviews                Review[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  follows                Follow[]
  feedback               Feedback[]
  pushSubscriptions      PushSubscription[]
  plusOnes               PlusOne[]
  reviewReplies          ReviewReply[]
  conversationParticipants ConversationParticipant[]
  sentMessages           Message[]
  companionTagsSent      CompanionTag[] @relation("CompanionTagTagger")
  companionTagsReceived  CompanionTag[] @relation("CompanionTagTagged")
  // Accept-to-Appear (§8, session 57)
  panelistInvites  EventPanelist[] @relation("PanelistInvites")
  celebrityInvites Celebrity[]     @relation("CelebrityInvites")

  // QST-2607-009 (10 Aug) - Google Sign-In. Standard Auth.js/@auth/prisma-adapter
  // shape, required for PrismaAdapter to persist OAuth account links. No
  // Session/VerificationToken tables added - not needed with the JWT
  // session strategy already in use (src/lib/auth.ts), only OAuth account
  // linkage needs a table.
  accounts Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Support widget: one table serves two entry points — the manual
// "Report a bug / suggest a feature" form, and the support chatbot's
// "I don't know that — want to send it to the team?" fallback.
// `fromChatbot` distinguishes them without needing two tables.
//
// `userId` is nullable — guests can submit feedback too (browse-first
// model, no reason to gate this behind login; see design doc §2).
//
// No admin UI to review these yet — that's a follow-up story. For now,
// query via Supabase MCP or curl the table directly. Kept deliberately
// minimal: this model's only job is to reliably capture the message.
model Feedback {
  id          String           @id @default(cuid())
  category    FeedbackCategory
  message     String
  pageUrl     String?
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  fromChatbot Boolean          @default(false)
  status      FeedbackStatus   @default(NEW)
  // Workflow overhaul (session 63, Hitesh's design). Two-field split:
  // `status` is the fix lifecycle (is it fixed yet?), `deployStage` is
  // the environment-promotion pipeline (is the fix live yet?) - these
  // move independently, especially under the current prod freeze where
  // everything caps out at DEPLOYED_QA regardless of status. Only
  // meaningful once status = RESOLVED; null otherwise. Existing 183
  // RESOLVED rows predate this field and stay null - no historical
  // record of which of those actually reached QA/prod, so left unknown
  // rather than guessed. Tracking starts clean from here forward.
  deployStage FeedbackDeployStage?
  // Human-readable sequential ID (e.g. "BUG-2608-001") - category
  // prefix + yearMonth + sequence, same shape as the existing
  // CodeCounter pattern used elsewhere. The cuid `id` above stays the
  // real primary key/FK target; `displayId` is purely for humans to
  // reference in conversation. Nullable + unique so existing rows can
  // be backfilled without a hard migration-time requirement.
  displayId   String?          @unique
  // Admin Dashboard v1 (session 33, 26 Jul, design.md §9.1/§9.5). Both
  // nullable, additive, no backfill required - existing rows read fine
  // with severity unset and a client-derived title fallback (first N
  // chars of `message`) until an admin actually triages them.
  severity    FeedbackSeverity?
  resolvedAt  DateTime?
  title       String?
  changeLog   FeedbackChangeLog[]
  // Optional screenshot, stored as a base64 data URL directly on the
  // row. Client resizes/recompresses to fit well under ~1MB before
  // encoding (see SupportWidget.tsx) so this stays cheap on Postgres.
  // NOT a scalable pattern past low volume — if attachments become
  // heavily used, migrate to Vercel Blob (or S3) and store a URL here
  // instead of the data itself. Fine for an MVP feedback widget.
  attachmentData String?
  createdAt   DateTime         @default(now())

  @@index([status, createdAt])
}

enum FeedbackStatus {
  NEW
  UNDER_REVIEW
  BUILD_QUEUE
  IN_BUILD
  BUILD_COMPLETE
  IN_TEST
  RESOLVED
  REJECTED
  REOPENED
}

// Only populated once FeedbackStatus = RESOLVED - tracks how far the fix
// has been promoted. Separate from `status` on purpose: fixed-and-in-QA
// can sit for a long time (current prod freeze) without meaning the
// underlying bug isn't actually fixed.
enum FeedbackDeployStage {
  DEPLOYED_QA
  IN_PRODUCT
  NOTIFIED_USER
  CLOSED
}

enum FeedbackSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Self-serve status/severity editing (Admin Dashboard v1) must not lose
// the reasoned trail that every Claude-driven status change used to get
// as prose in design.md - this is that trail, structured. `message` on
// Feedback itself stays immutable; this is the only place edits land.
model FeedbackChangeLog {
  id              String   @id @default(cuid())
  feedbackId      String
  feedback        Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  changedByUserId String?
  field           String
  fromValue       String?
  toValue         String
  // Workflow overhaul (session 63): free-text context for a transition -
  // the rejection reason when status -> REJECTED, or the reopen comment
  // when status -> REOPENED. Optional so ordinary status-only changes
  // (e.g. IN_BUILD -> BUILD_COMPLETE) don't need one.
  note            String?
  createdAt       DateTime @default(now())

  @@index([feedbackId])
}

enum FeedbackCategory {
  BUG
  FEATURE_IDEA
  QUESTION
  GENERAL
  OTHER
}

// Mirrors PasswordResetToken's shape. Email verification is deliberately
// non-blocking (see register/route.ts) — this just tracks whether the link
// has been clicked, it never gates login.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Phone OTP, used for both signup verification and OTP-based login.
model Otp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String // "LOGIN" | "SIGNUP_VERIFY"
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

// Backing counter for User/Artist/Organiser/VenueOwner.code generation.
// One row per (prefix, yearMonth); incremented atomically by the
// generate_role_code() DB function so concurrent signups can't collide.
model CodeCounter {
  prefix     String
  yearMonth  String
  currentSeq Int    @default(0)

  @@id([prefix, yearMonth])
}

// Session 39 (Hitesh's design, PR #224) - when an artist types a new
// genre into GenrePicker's "Other" field, it shows on THEIR OWN profile
// immediately (no blocking, Artist.genre is untouched/unrestricted), but
// does NOT become a public filter-chip option on /artists until an admin
// approves it here. Protects the shared surface from garbage without
// gating the individual's own page. Only genre needs this - Facility and
// Vibe/Dress-Code free text is never used to build a public filter
// anywhere, confirmed by search before building this.
model GenreRequest {
  id         String             @id @default(cuid())
  value      String             @unique
  status     GenreRequestStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  reviewedAt DateTime?
}

enum GenreRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Artist {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  bio          String?
  genre        String[]
  styleTag     String[]
  videoReel    String[]
  socialLinks  Json?
  createdAt    DateTime @default(now())

  // "Artist Background" (23 Jul, Hitesh's expanded scope) - a richer,
  // optional storytelling section beyond the short `bio` used in card
  // previews. All nullable/optional by design - no artist is forced to
  // fill any of this in.
  tagline         String? // one-line personal motto, shown prominently
  fullBiography   String? // long-form bio, distinct from the short `bio`
  journey         String? // their story/history in the art world
  influences      String? // collaborator addition - who inspired them
  acknowledgments String? // "if he wants to thank someone"
  goals           String? // ambitions/goals

  // Generated by DB trigger on insert, format ART<YYMM><6-digit seq>.
  code String? @unique

  applications  Application[]
  performances  Performance[]
  organiserRatings OrganiserArtistRating[]
  tourStops     ArtistTourStop[]
  tourConsents  TourArtistConsent[]

  // Scene Status (reputation epic §1, amended session 55) — Headliner tier
  // is deliberately fully manual, admin-only, no formula/threshold. Admin
  // weighs whatever signals matter (audience reaction, gig count, organiser
  // rating, Hype Score) and sets this directly - "not a small thing to get,
  // it's supposed to be earned." See docs/artist-reputation-system-design.md
  // Amendment 1.
  isSceneStatusHeadliner Boolean @default(false)
  // Optional admin audit note captured at the moment Headliner is granted
  // (session 55, /dashboard/admin/artists) - not required, but since the
  // tag is meant to be deliberate/earned, worth a lightweight paper trail
  // of why. Not shown publicly, admin-only, same as organiser ratings.
  headlinerNote          String?

  corporateInquiries CorporateBookingInquiry[]
}

// FEAT-2608-046 (11 Aug) - corporate show booking, scoped as inquiry-only
// per Hitesh's call: no payment flow, since K2 payout (manual-transfer
// ledger) isn't built yet and the §9(5)/194-O TDS consultation is still
// pending - moving real corporate money through the platform before either
// of those lands isn't something to build now. This is a lead-gen form: a
// corporate buyer (not necessarily an AFA account holder - no auth
// required to submit) reaches a verified artist, and everything past
// submission (negotiation, contract, payment) happens off-platform, same
// as it already does today without this feature. Meant as a natural
// fast-follow into a real booking flow once K2 + tax clearance land.
enum CorporateInquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model CorporateBookingInquiry {
  id            String                 @id @default(cuid())
  artistId      String
  artist        Artist                 @relation(fields: [artistId], references: [id])
  companyName   String
  contactName   String
  contactEmail  String
  contactPhone  String?
  eventType     String?
  city          String?
  preferredDate DateTime?
  budgetRange   String?
  message       String?
  status        CorporateInquiryStatus @default(NEW)
  createdAt     DateTime               @default(now())

  @@index([artistId])
}

// FEAT-2608-047 (11 Aug) - self-managed list of tour stops so an artist
// can show they perform beyond Pune/India (country, continent, world),
// distinct from Performance (which is a real AFA-booked event on this
// platform - a tour stop is informational only, not tied to a booking
// flow, since those shows aren't happening through AFA). Full-replace on
// save from the artist edit page, same pattern as Event.ticketTiers -
// the artist always sends their complete current list, not a diff.
model ArtistTourStop {
  id        String    @id @default(cuid())
  artistId  String
  artist    Artist    @relation(fields: [artistId], references: [id])
  city      String
  country   String
  date      DateTime?
  link      String?
  createdAt DateTime  @default(now())

  @@index([artistId])
}

enum FollowTargetType {
  ARTIST
  VENUE
  ORGANISER
}

// Follows an Artist, Venue, or Organiser. userId is the follower (any role
// can follow, though realistically Audience) - targetType/targetId identify
// what's being followed, without a direct FK (deliberately polymorphic - one
// table instead of three near-identical ones). notifyEnabled is the
// YouTube-style bell: following alone doesn't push anything, the bell is a
// separate opt-out toggle (defaults on, since notifications are the entire
// point of following here, unlike a feed-only follow elsewhere).
model Follow {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  targetType    FollowTargetType
  targetId      String
  notifyEnabled Boolean          @default(true)
  createdAt     DateTime         @default(now())

  @@unique([userId, targetType, targetId])
}

model Organiser {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  orgName     String
  bio         String?
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Generated by DB trigger on insert, format ORG<YYMM><6-digit seq>.
  code String? @unique

  // Simple running balance - grows when an Organiser chooses to keep a
  // cancelled Buy-in artist's amount as wallet credit instead of
  // refunding it (see Performance.buyInRefundStatus). No spend/reuse
  // flow built yet - deliberately just the ledger for now, until a real
  // "spend it on X" mechanism is actually needed.
  walletBalance Float @default(0)

  // Route linked account for direct organiser payouts (K2). Nullable -
  // most Organisers won't have one until they complete the (currently
  // Dashboard-driven, test-mode) onboarding step. Status is refreshed
  // from Razorpay on save/lookup rather than trusted as a local cache -
  // see razorpay-account route. Only "activated" accounts are used as a
  // transfer destination in POST /api/bookings; "created" (not yet bank-
  // verified) accounts are stored but not split to, since an unverified
  // account can't actually receive settlements yet.
  razorpayAccountId     String?
  razorpayAccountStatus String?

  // Manual-transfer payout compliance fields (added 28 Jul, after
  // confirming Razorpay Route is unavailable on this account - RBI's
  // 2025 PA Directions restrict split-settlement to merchants above a
  // turnover threshold this business doesn't clear yet - see design
  // doc §4.5 correction). Not used by any tax-withholding logic yet;
  // added now so the fields exist before real payout rows do, rather
  // than retrofitting a migration once money is already moving.
  //
  // entityType matters specifically for Section 194-O TDS: the ₹5
  // lakh/year exemption threshold only protects INDIVIDUAL/HUF -
  // every other entity type has TDS apply from the first rupee, no
  // threshold at all.
  entityType    OrganiserEntityType @default(UNKNOWN)
  panNumber     String?
  gstRegistered Boolean             @default(false)
  gstin         String?

  events        Event[]
  venueBookings VenueBooking[]
  bookingRequests VenueBookingRequest[]
  payoutLedgerEntries OrganiserPayoutLedger[]
  artistRatings OrganiserArtistRating[]
  tours         Tour[]
}

// Artist Reputation epic (design doc, session 52-53) - the one genuine
// net-new schema piece. Organiser's private rating of an Artist after a
// specific Performance. NEVER shown publicly - raw score/comment feed
// only into Scene Status (Artist model, §1) and are otherwise visible
// only to the rating Organiser and the rated Artist. Scoped per
// Performance (not a single running score per Organiser-Artist pair) so
// an Organiser can rate the same Artist again after a later booking, and
// so a rating can be tied back to a specific real gig if ever disputed.
// One rating per Organiser per Performance - re-rating updates in place
// via upsert on the unique constraint rather than allowing duplicates to
// pile up.
model OrganiserArtistRating {
  id            String      @id @default(cuid())
  organiserId   String
  organiser     Organiser   @relation(fields: [organiserId], references: [id])
  artistId      String
  artist        Artist      @relation(fields: [artistId], references: [id])
  performanceId String
  performance   Performance @relation(fields: [performanceId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([organiserId, performanceId])
}

// Not yet consulted with a CA - entity type matters for Section 194-O
// TDS applicability (see Organiser.entityType comment above). UNKNOWN
// is the default so existing/new Organisers aren't silently assumed
// into a category that changes their tax treatment.
enum OrganiserEntityType {
  UNKNOWN
  INDIVIDUAL
  HUF
  COMPANY
  LLP
  PARTNERSHIP
  OTHER
}

model VenueOwner {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  // Session 62, design.md §9.5 - Organiser already had bio, VenueOwner
  // didn't. Powers the public VenueOwner bio profile page.
  bio         String?
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Generated by DB trigger on insert, format VEN<YYMM><6-digit seq>.
  code String? @unique

  venues      Venue[]
}

model Venue {
  id            String   @id @default(cuid())
  ownerId       String
  owner         VenueOwner @relation(fields: [ownerId], references: [id])
  name          String
  address       String
  city          String
  // Structured location data from Places API (New) autocomplete
  // (session 36, 26 Jul - Feedback f7bd07eb, §9.5 budget approved 25 Jul).
  // Both nullable/optional - existing venues have neither and aren't
  // backfilled; city stays the required field it always was, these are
  // additive enrichment only, populated going forward as venues are
  // created/edited through the new autocomplete flow.
  state         String?
  country       String?
  lat           Float?
  lng           Float?
  // Google's stable Place ID from the Address autocomplete's Place
  // Details response (session 38, 26 Jul - PR #212). Only set when
  // Address was resolved via autocomplete (mirrors lat/lng - all three
  // are set/cleared together). Lets Get Directions build an exact
  // named pin (`.../maps/place/?q=place_id:...`) instead of a bare
  // coordinate drop, and lets the Google Maps Link field become a
  // read-only "Directions" label instead of asking the owner to
  // separately go find and paste a link for an address we already
  // resolved. Manually-typed addresses (no autocomplete match) leave
  // this null and keep the existing free-text mapsUrl field editable.
  placeId       String?
  mapsUrl       String?
  capacity      Int
  photos        String[]
  facilities    String[]
  acousticRating Float?
  seatMap       Json?
  isApproved    Boolean  @default(false)
  createdAt     DateTime @default(now())

  // §4.5 - rental rate type. Nullable/optional so existing venues aren't
  // forced into a value; treat missing rateType as "not yet configured"
  // in the UI rather than defaulting silently to one option.
  rateType         RateType?
  hourlyRate       Float?
  dailyRate        Float?
  minDurationHours Int?

  // §9.4 twenty-fourth amendment - opt-in numbered seating, additive only.
  // GENERAL_ADMISSION (default) is the existing tier/quantity flow, fully
  // untouched. NUMBERED venues get a real Seat layout via the builder;
  // Bookings for NUMBERED events use BookingSeat instead of the seats
  // Json qty map on Booking. Old venues never touch this - column has a
  // default, no backfill needed.
  seatingMode   VenueSeatingMode @default(GENERAL_ADMISSION)
  seats         Seat[]
  zonePrices    VenueZonePrice[]
  markers       VenueMarker[]
  underlays     VenueLevelUnderlay[]

  // §9.4 Freeze + method persistence (session 48, 31 Jul) - explicit
  // "this seat map is finalized" action. While true, PUT /api/venues/[id]/
  // seats rejects writes (409) - owner must Unfreeze first via the
  // dedicated PATCH action. Venue-level, not per-level: multi-level
  // venues freeze/unfreeze together, matching how Hitesh described this
  // ("once a seat map is genuinely finalized"), not a case of partial
  // per-level lock.
  seatMapFrozen Boolean @default(false)

  availability  VenueAvailability[]
  bookings      VenueBooking[]
  events        Event[]
  bookingRequests VenueBookingRequest[]
  dayRates      VenueDayRate[]

  // FEAT-2608-036 (2 Aug) - default-location filter reads this column on
  // every Events/Venues listing request once that filter is wired to a
  // real WHERE clause, so an index pays for itself immediately rather
  // than waiting on a future migration.
  @@index([city])
}

// §9.4 twenty-fourth amendment - real x/y canvas coordinates (not a
// rows x columns grid) so the builder can represent true venue shapes.
// tierLabel is a free-text section/price-tier name, deliberately not a
// foreign key to TicketTier - TicketTier is per-Event, Seat is per-Venue
// (a venue's physical layout doesn't change per event), so pricing for
// a given event/tier combination is resolved at booking time by matching
// tierLabel, not by a hard relation.
model Seat {
  id        String @id @default(cuid())
  venueId   String
  venue     Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tierLabel String
  // Venue level (Ground Floor, Balcony, etc). Empty string is the
  // implicit single level - existing single-level venues need no
  // backfill, stays invisible in the UI unless the owner adds a level.
  level     String @default("")
  row       String
  number    String
  x         Float
  y         Float

  bookingSeats BookingSeat[]

  // Rows can legitimately repeat across levels (Ground row A vs Balcony
  // row A), so uniqueness must include level, not just venueId+row+number.
  @@unique([venueId, level, row, number])
  @@index([venueId, tierLabel])
}

// Per-zone suggested/default price, shown to the organiser at event
// creation as a prefill they can override - NOT a lock. The actual price
// an audience member pays still comes from TicketTier.price per event,
// same as today; this table only removes the "start from a blank field"
// gap for NUMBERED venues. Separate table (not a Seat column) since a
// zone spans many seats and a price shouldn't be denormalized per-seat.
model VenueZonePrice {
  id             String @id @default(cuid())
  venueId        String
  venue          Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  level          String @default("")
  zoneName       String
  suggestedPrice Float?

  @@unique([venueId, level, zoneName])
}

// §9.4 seat-map cluster item #6 (31 Jul session 48/49) - safety/reference
// markers (gates, fire extinguishers, stage-distance reference points),
// scoped as potentially Fire-NOC-relevant. Same coordinate system as Seat
// (per-level, canvas x/y in the builder's own px space) so markers move
// with the layout on the same canvas, not a separate overlay. Builder-only
// + read-only preview for now (Organiser/Admin compliance visibility) -
// deliberately not surfaced on the audience-facing SeatPicker, since this
// is Venue Owner documentation, not booking UX.
model VenueMarker {
  id        String          @id @default(cuid())
  venueId   String
  venue     Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  type      VenueMarkerType
  level     String          @default("")
  x         Float
  y         Float
  label     String          @default("")
  // Only meaningful for STAGE_DISTANCE_REF - manually entered, since there's
  // no real-world scale calibration to auto-measure from the canvas.
  distanceMeters Float?

  @@index([venueId, level])
}

// §9.4 seat-map cluster item #5 (session 49) - PDF/image reference
// underlay. Scoped as a fixed-fit background image per level (stretched
// to the canvas's content bounds, opacity-adjustable) - no independent
// pan/zoom/rotation alignment in v1, same kind of deliberate scope cut
// as curved rows being flagged-but-not-built elsewhere in this doc.
// "PDF" in the design.md name is handled as an image (a floor-plan PDF
// page exported/screenshotted as an image) - rendering a PDF page
// natively as a canvas background is real added complexity with no
// clear ask for it yet.
model VenueLevelUnderlay {
  id       String @id @default(cuid())
  venueId  String
  venue    Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  level    String @default("")
  imageUrl String
  opacity  Float  @default(0.4)

  @@unique([venueId, level])
}

// §9.4 twenty-fourth amendment - join table for NUMBERED-mode bookings.
// Deliberately separate from Booking.seats (the GA qty map) rather than
// overloading that Json field with a different shape per event mode -
// keeps the existing GA capacity-check code path completely untouched.
// Occupancy for a NUMBERED event's seat is: any BookingSeat whose
// Booking is CONFIRMED, or PENDING with expiresAt in the future (mirrors
// the existing TicketTier capacity-check pattern in POST /api/bookings).
model BookingSeat {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatId    String
  seat      Seat    @relation(fields: [seatId], references: [id])

  @@unique([bookingId, seatId])
  @@index([seatId])
}

model TicketTier {
  id          String @id @default(cuid())
  eventId     String
  event       Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sectionName String
  // NUMBERED-venue zones can legitimately share a name across different
  // venue levels (e.g. "General" on Ground and Balcony) - level scopes
  // the price to the right one. Empty string is the implicit single
  // level, same convention as Seat.level - GA tiers and pre-existing
  // single-level NUMBERED tiers need no backfill.
  level       String @default("")
  price       Float
  totalSeats  Int
}

model VenueBookingRequest {
  id             String                    @id @default(cuid())
  organiserId    String
  organiser      Organiser                 @relation(fields: [organiserId], references: [id])
  venueId        String
  venue          Venue                     @relation(fields: [venueId], references: [id])
  eventId        String?
  event          Event?                    @relation(fields: [eventId], references: [id])
  requestedDate  DateTime
  durationHours  Int
  status         VenueBookingRequestStatus @default(PENDING)
  createdAt      DateTime                  @default(now())

  offers VenueBookingOffer[]
}

model VenueBookingOffer {
  id          String               @id @default(cuid())
  requestId   String
  request     VenueBookingRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proposedBy  OfferProposedBy
  amount      Float
  // From live feedback (18 Jul) - a tester who'd just used the Flexible
  // negotiation flow asked for a free-text field alongside the amount so
  // either side can add context ("can do ₹4000 but need load-in by 6pm")
  // instead of just exchanging bare numbers. Optional, not required at
  // any point in the flow.
  comment     String?
  createdAt   DateTime             @default(now())
}

// Singleton config row. The DEAD columns (flatVenueBookingFee,
// ticketCommissionRate, performerSlotCommissionRate) are from a
// pre-fifth-amendment design and are never read by application code;
// they're kept only to match the actual DB shape. See master design
// doc §4.5 / §9.5 for why they're retired.
//
// audienceBookingFee is the live field (Checkpoint 4). Stored in
// PAISE (integer) for consistency with Payment.amount. UI converts
// to/from rupees on display + save. Value of 0 means "no fee".
model PlatformSettings {
  id                           String   @id @default("singleton")
  audienceBookingFee           Int      @default(0)
  // Admin-configurable band around audienceBookingFee (the "standard"
  // value above). minAudienceBookingFee is the floor an audience member
  // can drop the fee to at checkout (default 0 = fee remains fully
  // optional unless admin raises the floor); maxAudienceBookingFee is the
  // per-transaction ceiling both the standard fee and any audience
  // override are validated against. Both are paise, both are bounded at
  // save-time by the hardcoded MAX_BOOKING_FEE_PAISE absolute ceiling in
  // platform-settings.ts (deploy-gated, admin can never exceed it) — see
  // design.md §9 for the 29 Jul decision.
  minAudienceBookingFee        Int      @default(0)
  maxAudienceBookingFee        Int      @default(50000)
  // Support chatbot per-session message cap. Enforced client-side via
  // sessionStorage (see SupportWidget.tsx) — not hardened against a
  // determined user clearing storage, but that's a deliberate trade-off:
  // the goal is cost/abuse control against ordinary usage patterns, not
  // security. A server-side counter would need a session/identity model
  // this guest-accessible feature doesn't otherwise need. Configurable
  // so Hitesh can raise/lower it from /dashboard/admin/settings without
  // a deploy. 0 or negative disables chat entirely as an emergency killswitch.
  chatMaxMessagesPerSession    Int      @default(15)
  /// @deprecated dead per fifth amendment — do not read
  flatVenueBookingFee          Float    @default(0)
  /// @deprecated dead per fifth amendment — do not read
  ticketCommissionRate         Float    @default(0.08)
  /// @deprecated dead per fifth amendment — do not read
  performerSlotCommissionRate  Float    @default(0.08)

  // Scene Status tier thresholds (reputation epic §1, amended session 55).
  // Configurable rather than hardcoded, deliberately - the design doc
  // itself says the exact formula is "TBD once we see real data volume",
  // and Scene Status is live-computed on every view (session 53), so a
  // config value can be tuned instantly as real usage patterns emerge, no
  // deploy/migration needed. Only Rising and Featured are automatic;
  // Headliner stays fully manual/admin-only by design, no config here for
  // it. See docs/artist-reputation-system-design.md Amendment 1.
  sceneStatusRisingMinGigs           Int   @default(3)
  sceneStatusRisingMinAvgRating      Float @default(4.0)
  sceneStatusRisingMinAttendees      Int   @default(5)
  sceneStatusFeaturedVouchThreshold  Int   @default(5)

  // Admin artist roster (session 56, /dashboard/admin/artists) - how many
  // of an artist's most recent scored shows to average for the roster's
  // Hype Score column. Configurable per Hitesh's call (session 56): "recent
  // 5 shows, configurable by admin". Distinct from the Rising thresholds
  // above - this is a display/aggregation setting, not a tier input; Hype
  // Score itself isn't part of the Rising formula.
  artistRosterHypeScoreLookback     Int   @default(5)

  // Audience Choice voting default weights (§6, session 58) - organiser
  // can override per event (Event.audienceVoteWeight etc, nullable,
  // resolves here when unset). Confirmed default 80/10/10, must always
  // sum to 100 and respect the doc's ~50% Audience floor - enforced at
  // the setter/API layer, not a DB constraint.
  audienceVoteWeightDefault  Int @default(80)
  panelistVoteWeightDefault  Int @default(10)
  celebrityVoteWeightDefault Int @default(10)

  // Feedback cms9ynuxi (2 Aug) - Hitesh: "what should be window of future
  // event creation - could be 3 by default. If beyond that ask permission
  // from admin." Enforced at event create/edit (see events/route.ts and
  // events/[id]/route.ts) as a hard month-count cap from today, checked
  // server-side (client date-picker max is a UX nicety, not the real
  // enforcement - trivially bypassed by calling the API directly).
  // Deliberately NOT built: a self-serve "request admin approval to
  // exceed this" workflow - that's a second, larger feature (needs a
  // request/approve queue, similar shape to the existing Pending Genre
  // Requests panel). For now, an organiser who genuinely needs a later
  // date is directed to contact admin via the support widget; scope
  // decision, not an oversight - see PR notes.
  eventCreationWindowMonths Int @default(3)

  // Direct Payouts (Razorpay Route) admin toggle - session 65. Route is
  // unavailable on this Razorpay account tier (confirmed 28 Jul - requires
  // ₹40L+ turnover per RBI Payment Aggregator Directions 2025), so K2
  // pivoted to a manual two-step transfer model (OrganiserPayoutLedger,
  // PR #263). This flag gates the pre-pivot "Direct Payouts" surfaces
  // (organiser dashboard link, /dashboard/organiser/payouts linking form,
  // payout-account POST) so they stop promoting a Route linking flow that
  // can't actually work. Default OFF. directPayoutsEnabledUntil is an
  // optional expiry, lazy-checked on read (no cron) - if set and in the
  // past, treated as disabled regardless of the bool, so admin can flip
  // this on temporarily (e.g. to re-test if the account tier changes)
  // without having to remember to flip it back off.
  directPayoutsEnabled       Boolean   @default(false)
  directPayoutsEnabledUntil  DateTime?

  updatedAt                    DateTime @updatedAt
}

// Display-only currency preference (Option A, session 47, 30 Jul). One row
// per supported currency; admin edits rateFromINR from /dashboard/admin/
// settings. This is a *display* conversion rate only, updated manually
// (not a live FX feed) - deliberate v1 choice, same shape as the existing
// admin-set audienceBookingFee pattern, avoiding a new external API
// dependency this early. INR itself has a row (rate 1) so the formatter
// can treat every currency uniformly rather than special-casing INR.
// Real settlement is always INR regardless of what this table shows -
// see User.displayCurrency and design.md §9 "Real multi-currency
// settlement (Option B)" for why that stays explicitly out of scope.
model DisplayCurrencyRate {
  code        String   @id // ISO 4217, e.g. "INR", "USD", "EUR", "GBP", "AED"
  label       String   // e.g. "US Dollar"
  symbol      String   // e.g. "$"
  rateFromINR Float    // 1 INR = this many units of `code`
  updatedAt   DateTime @updatedAt
}


model VenueAvailability {
  id          String   @id @default(cuid())
  venueId     String
  venue       Venue    @relation(fields: [venueId], references: [id])
  date        DateTime
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model VenueBooking {
  id           String        @id @default(cuid())
  venueId      String
  venue        Venue         @relation(fields: [venueId], references: [id])
  organiserId  String
  organiser    Organiser     @relation(fields: [organiserId], references: [id])
  eventId      String?
  fromDate     DateTime
  toDate       DateTime
  status       BookingStatus @default(PENDING)
  amount       Float
  createdAt    DateTime      @default(now())

  // §4.5 - snapshotted at confirmation time so later changes to the
  // Venue's published rates don't retroactively alter a confirmed booking.
  // F6: snapshotHourlyRate / snapshotDailyRate added to fully close the
  // rate-drift gap; the pre-existing four fields captured the deal shape
  // (duration, type, platform fee) but not the actual rate applied.
  agreedRateType     RateType?
  durationHours      Int?
  durationDays       Int?
  platformFeeAmount  Float?
  snapshotHourlyRate Float?
  snapshotDailyRate  Float?
}

model Event {
  id             String      @id @default(cuid())
  organiserId    String
  organiser      Organiser   @relation(fields: [organiserId], references: [id])
  venueId        String?
  venue          Venue?      @relation(fields: [venueId], references: [id])
  title          String
  description    String
  type           EventType
  status         EventStatus @default(DRAFT)
  date           DateTime
  startTime      String
  endTime        String
  isFree         Boolean     @default(false)
  ticketPrice    Float?
  totalSeats     Int
  availableSeats Int
  food           Json?
  dresscode      String?
  vibe           String?
  surpriseAct    Boolean     @default(false)
  posterImage    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // §4.5 - ticketPrice above stays for backward compat with existing
  // Organiser dashboard pages until they're migrated to per-section
  // pricing via ticketTiers. New events should prefer ticketTiers.
  maxPerformers        Int?
  applicationApprovalMode ApprovalMode @default(MANUAL)
  maxSeatsPerBooking   Int          @default(4)

  // "+1" mandatory audience support - Organiser sets this at event level
  // (applies to every artist in the lineup independently, not shared - two
  // different artists each need their own N supporters). 0 = not required.
  // Exists because some Organisers charge a spot fee but still can't fill
  // the room, so require each artist to bring guaranteed audience - this
  // was previously an off-platform WhatsApp/friend-network scramble.
  plusOnesRequired Int @default(0)

  // Default artist compensation terms, declared publicly at event
  // creation so an Artist can see payment terms BEFORE applying, rather
  // than finding out only after being approved (real gap - Performance's
  // own compensationType/feeAmount/buyInAmount were only ever set at
  // approval time, per-artist, invisible to the applicant). Organiser can
  // still override per-artist at approval time for real exceptions (e.g.
  // negotiating a different fee with a headliner) - this is the
  // published default, not a hard lock. Mirrors Performance's own
  // CompensationType/feeAmount/buyInAmount shape exactly.
  defaultCompensationType CompensationType @default(FREE)
  defaultFeeAmount        Float?
  defaultBuyInAmount      Float?

  lineup        Performance[]
  applications  Application[]
  bookings      Booking[]
  reviews       Review[]
  ticketTiers   TicketTier[]
  bookingRequests VenueBookingRequest[]

  // Competition show (31 Jul feedback, "as a collaborator" question,
  // Hitesh confirmed shape same session): an optional layer on top of any
  // existing EventType, not a new EventType value itself - a STAND_UP or
  // OPEN_MIC event can equally be a competition. isCompetitionShow gates
  // whether the panelist/prize/celebrity fields below are shown/editable
  // at all; they're meaningless (and hidden) when false. Prize captured
  // by rank per Hitesh's choice - free-text per rank rather than a
  // structured amount+item split, since prizes are often mixed (cash +
  // trophy + feature slot) and forcing them into fields would fight the
  // organiser rather than help them.
  isCompetitionShow    Boolean @default(false)
  competitionPrizeFirst  String?
  competitionPrizeSecond String?
  competitionPrizeThird  String?

  // Celebrity attending - DEPRECATED session 57 (reputation epic §8,
  // Accept-to-Appear). Promoted to its own Celebrity model below so a
  // consent status (PENDING/ACCEPTED/DECLINED) + userId can be attached
  // cleanly, same shape as EventPanelist, and to open the door to more
  // than one celebrity per event later. Columns kept (not dropped) per
  // the standing "don't drop until matching code merges" rule - one QA
  // test event still has celebrityAttendingName set, backfilled into the
  // new model at PENDING (no real consent existed under the old scalar
  // fields, so PENDING - not ACCEPTED - is the honest status). No code
  // reads/writes these columns anymore as of this commit.
  celebrityAttendingName String? // @deprecated - use Celebrity model
  celebrityPhotoUrl      String? // @deprecated - use Celebrity model

  panelists   EventPanelist[]
  celebrities Celebrity[]

  // Audience Choice voting (§6, session 58) - organiser-chosen weighting
  // per event, nullable so an event that never touches this always
  // follows the current PlatformSettings default rather than freezing at
  // whatever the default happened to be when the event was created.
  // Confirmed default (Hitesh, session 58): 80/10/10 - leaning harder
  // into "Audience Choice" than the design doc's own 70/20/10 example.
  audienceVoteWeight  Int?
  panelistVoteWeight  Int?
  celebrityVoteWeight Int?
  votes               CompetitionVote[]

  // FEAT-2608-045 (11 Aug) - event-specific terms. termsChecklist stores
  // selected keys from the fixed checklist in src/lib/event-terms.ts (not
  // a DB enum, so the list stays easy to tweak) - deliberately NOT free
  // text, so an organiser can't accidentally write something that
  // conflicts with AFA's own refund/cancellation policy (that policy is
  // platform-wide and NOT stored per-event - see src/lib/refund-policy.ts
  // / the static policy page). specialNotes is the one free-text
  // exception, capped at 300 chars in the UI, gated behind admin review
  // (specialNotesStatus) before it's shown publicly - never auto-visible.
  // Editing specialNotes after approval resets status back to PENDING
  // (enforced in the API route, not the DB) so a bland approved note
  // can't be quietly swapped for something that shouldn't be there.
  termsChecklist              String[]          @default([])
  specialNotes                String?
  specialNotesStatus          EventNoteStatus   @default(NONE)
  specialNotesRejectionReason String?
  specialNotesReviewedAt      DateTime?

  // FEAT-2608-045 follow-up (11 Aug) - structured age limit, replacing
  // the AGE_RESTRICTION checklist checkbox (a plain checkbox couldn't
  // say WHAT the age limit actually was - an organiser had to fall back
  // to specialNotes just to say "16+", which meant an extra admin-review
  // round-trip for something that should just be a dropdown value).
  // Nullable/optional - "not specified" is the default, same as
  // dresscode/vibe. Preset options in src/lib/event-terms.ts; "Other"
  // free text follows the same PresetSelectWithOther pattern already
  // used for Dress Code/Vibe, so this is just a plain string, not an
  // enum - keeps the "type your own" escape hatch cheap.
  ageLimit String?

  // Tour by Organiser (12 Aug). category defaults STANDALONE so every
  // existing Event row is valid with no backfill. tourId is set only
  // when category is TOUR_STOP - enforced in the API layer, not the DB,
  // same pattern as specialNotes/specialNotesStatus above.
  category            EventCategory @default(STANDALONE)
  tourId               String?
  tour                 Tour?    @relation(fields: [tourId], references: [id])

  // Open local/beginner slots alongside a Tour stop's fixed headliner
  // lineup (Hitesh, 12 Aug: "organiser decide how many open spot for
  // local artist, duration too"). Reuses the existing Application/
  // Performance flow unchanged - openSlotCount/slotDuration/
  // applicationDeadline just gate whether the Apply action is shown and
  // when it closes; approval is the same organiser review as any other
  // event. Only meaningful when category is TOUR_STOP, but not DB-
  // restricted to it in case a future STANDALONE event wants the same
  // shape - no reason to hard-couple them.
  openSlotCount        Int?
  slotDuration         Int?
  applicationDeadline  DateTime?
}

// Accept-to-Appear (reputation epic §8, session 57) - shared status enum
// for EventPanelist and Celebrity. Closes a real gap in what PR #300
// shipped: an organiser could previously name/photo *any* person as
// Panelist or Celebrity Attending with zero verification from them -
// live reputational/legal exposure once public. Now: organiser invites
// by lookup, status starts PENDING (visible only to the organiser while
// building the event), the person accepts/declines from their own AFA
// account, and only ACCEPTED entries ever appear on the public
// poster/event page - presence on the poster *is* the proof of consent.
enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Structured panelist entries for competition shows (name + bio + photo
// each, per Hitesh's choice) - a real one-to-many, not a Json blob, so
// each panelist gets its own photo upload slot and can be reordered/
// removed independently. `order` is organiser-controlled display order,
// not creation order (photo uploads reuse the existing Vercel Blob store,
// same pattern as venue underlays and avatars - no new infra).
model EventPanelist {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  bio       String?
  photoUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  // Accept-to-Appear (§8, session 57). name/photoUrl above stay as the
  // organiser's PENDING-stage draft; once status flips to ACCEPTED, the
  // public-facing read swaps to the linked user's own profile name/avatar
  // instead - an organiser can invite someone but can't put words or an
  // image in their mouth the person didn't put there. Existing rows (all
  // pre-dating this field) default PENDING, matching honest current
  // consent state - none of them have actually been accepted by anyone.
  status      InviteStatus @default(PENDING)
  userId      String?
  user        User?        @relation("PanelistInvites", fields: [userId], references: [id])
  respondedAt DateTime?
}

// Celebrity attending (§8, session 57) - promoted from two scalar fields
// on Event (see deprecation note there) to its own model, same shape and
// same reasoning as EventPanelist. `order` future-proofs multiple
// celebrities per event even though today's UI still only surfaces one.
model Celebrity {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  photoUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  status      InviteStatus @default(PENDING)
  userId      String?
  user        User?        @relation("CelebrityInvites", fields: [userId], references: [id])
  respondedAt DateTime?
}

// Audience Choice voting (reputation epic §6, session 58) - three voter
// categories, each ranking their own top 3 (Borda 3/2/1). voterId's
// meaning is category-dependent: bookingId for AUDIENCE (one vote per
// booking, not per attendee - the same per-booking check-in limitation
// §3/§7 already document), userId for PANELIST/CELEBRITY (must have an
// ACCEPTED invite for this specific event, §8). A person eligible in more
// than one category (e.g. an accepted panelist who also bought a ticket)
// gets a separate ballot per category they qualify for - these are role-
// based ballots, not mutually exclusive identities.
enum VoterCategory {
  AUDIENCE
  PANELIST
  CELEBRITY
}

model CompetitionVote {
  id            String        @id @default(cuid())
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category      VoterCategory
  voterId       String
  performanceId String
  performance   Performance   @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  rank          Int
  createdAt     DateTime      @default(now())

  // One rank slot per voter per category (can't cast two different
  // performances at rank 1, say), and one vote per performance per voter
  // per category (can't rank the same performance at both 1st and 2nd).
  @@unique([eventId, category, voterId, rank])
  @@unique([eventId, category, voterId, performanceId])
}

model Application {
  id        String            @id @default(cuid())
  eventId   String
  event     Event             @relation(fields: [eventId], references: [id])
  artistId  String
  artist    Artist            @relation(fields: [artistId], references: [id])
  message   String?
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
}

model Performance {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id])
  slot      Int
  duration  Int
  createdAt DateTime @default(now())

  // §4.5 - defaults to FREE (the existing open-mic/exposure norm) so
  // every current Performance row is valid without a data backfill.
  compensationType CompensationType @default(FREE)
  feeAmount        Float?
  buyInAmount      Float?

  reviews   Review[]
  plusOnes  PlusOne[]
  organiserRatings OrganiserArtistRating[]
  votes     CompetitionVote[]

  // Artist self-cancellation (session 21, 23 Jul). cancelledAt null =
  // active slot. Cancelling within 24h of the event is blocked entirely
  // at the API level - this field only ever gets set for a genuine
  // >=24h-ahead cancellation, so its mere presence doesn't need a
  // separate "was this in time" check anywhere else.
  cancelledAt       DateTime?
  // Only meaningful when compensationType is BUY_IN and cancelledAt is
  // set. Defaults to REFUNDED the moment a Buy-in artist cancels (Hitesh:
  // "no one will be punished... paid amount will be returned to
  // artist") - WALLET_CREDITED only happens if the Organiser explicitly
  // chooses to keep it afterward, never the artist's call and never the
  // default.
  buyInRefundStatus BuyInRefundStatus?

  // Scene Status Featured tier (reputation epic §1, amended session 55).
  // Organiser marks an artist Featured at lineup placement/management time
  // (this Performance row) - distinct from the post-show OrganiserArtistRating
  // flow, no dependency on it. Featured tier itself is live-computed: count
  // of DISTINCT organisers (via Event.organiserId) who've set this true for
  // the artist, compared against PlatformSettings.sceneStatusFeaturedVouchThreshold.
  // Distinct-organiser (not raw vouch count) deliberately prevents one
  // organiser gaming it via repeat bookings of the same artist. See
  // docs/artist-reputation-system-design.md Amendment 1.
  isFeaturedVouch Boolean @default(false)
}

enum BuyInRefundStatus {
  REFUNDED
  WALLET_CREDITED
}

// A "+1" pledge - an audience member confirming they'll be a specific
// artist's guaranteed guest for an event that requires it (Event.plusOnesRequired).
// Deliberately per-Performance (artist's slot), not per-Event, even though
// the requirement is set event-wide - each artist in a lineup fills their
// own N independently. bookingId always points at a real, confirmed ticket
// (₹0 if the user had none yet, or their existing booking if they already
// had one for this event) so door check-in has something scannable - a
// pledge with nothing to show at the door doesn't solve the actual problem.
model PlusOne {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  performanceId String
  performance   Performance @relation(fields: [performanceId], references: [id])
  bookingId     String
  booking       Booking     @relation(fields: [bookingId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([userId, performanceId])
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  eventId     String
  event       Event         @relation(fields: [eventId], references: [id])
  seats       Json
  totalAmount Float
  // Checkpoint 4 — audience booking fee split.
  // subtotalAmount    = ticket revenue that goes to the Organiser
  // bookingFeeAmount  = platform's cut (audience-side booking fee)
  // totalAmount       = grand total the audience pays (subtotal + fee)
  // Backfilled on migration: existing rows get subtotal = totalAmount,
  // bookingFeeAmount = 0. Free events stay 0/0/0 forever — per About
  // page, the platform doesn't tax free events.
  subtotalAmount   Float @default(0)
  bookingFeeAmount Float @default(0)
  status      BookingStatus @default(PENDING)
  // Checkpoint 2 — deprecated in favor of the Payment model (below). Kept
  // in the schema for migration safety; nothing in the new payment flow
  // reads or writes it. Remove in a later cleanup once we're sure no old
  // code references it.
  paymentId   String?
  ticketCode  String?       @unique
  createdAt   DateTime      @default(now())

  // Checkpoint 2 — 15-minute TTL on PENDING bookings, so an abandoned
  // checkout doesn't permanently eat capacity. Set at creation time to
  // NOW + 15min; cleared when the booking transitions to CONFIRMED.
  // Capacity checks filter out PENDING rows where expiresAt < NOW().
  expiresAt   DateTime?

  // Ticket delivery tracking. Lives on Booking (not Payment) so free
  // events — which have no Payment row — can be tracked by the same
  // single-flight claim. Backfilled from Payment on migration; new rows
  // set this at delivery time via `updateMany WHERE deliveredAt IS NULL`.
  // See Master Design Doc §9.2 / EPIC M for the bug this fixes.
  deliveredAt   DateTime?
  deliveryError String?

  // Check-in/scan flow (EPIC N). Set once, at the door, by whoever scans
  // the QR (or enters the code manually) - Organiser of the event or an
  // Admin. checkedInByUserId is a plain scalar (not a relation) since it
  // just needs to be a display-only "who scanned this" audit trail, not
  // something queried from the User side.
  checkedInAt       DateTime?
  checkedInByUserId String?

  // Post-show rating prompt (reputation epic §5). Set once the push has
  // fired for this booking so the cron never double-sends - "one push
  // per event" is a hard rule in the design (repeat pestering risks
  // eroding trust in the push channel generally).
  ratingPromptSentAt DateTime?

  // Audience self-serve cancellation (design.md "Refund policy",
  // session 47, 29 Jul - graduated tiers by days-before-event).
  // cancelledAt is set for both CANCELLED (no refund, <7 days) and
  // REFUNDED (>=7 days, real money moved) outcomes - status alone
  // distinguishes which. refundAmount is the actual amount refunded
  // (0 for CANCELLED, the computed tier amount for REFUNDED) -
  // recorded even when 0 so the audience member's ticket history
  // shows what was evaluated, not just what moved. razorpayRefundId
  // is null unless a real Razorpay refund call succeeded.
  cancelledAt      DateTime?
  refundAmount     Float?
  razorpayRefundId String?

  // Companion Tagging Phase 1 (reputation epic §7). Consent is captured
  // once per booking, at checkout, and covers using the resulting tags
  // for Verified/Repeat Attendee counts and Scene Status computation -
  // not just "share who I went with" visibility. Deliberately separate
  // from any individual CompanionTag row so revoking consent later (not
  // built yet, but the field exists for it) doesn't require touching
  // every tag. False/null by default - tagging is opt-in, never assumed.
  companionTaggingConsent   Boolean   @default(false)
  companionTaggingConsentAt DateTime?
  companionTags             CompanionTag[]

  payment     Payment?
  bookingSeats BookingSeat[]
  plusOnes    PlusOne[]
  payoutLedgerEntry OrganiserPayoutLedger?

  @@index([status, expiresAt])
  @@index([checkedInAt, ratingPromptSentAt])
}

// Companion Tagging Phase 1 - checkout-time capture. Tagging links a real
// AFA account (not free text), which is why this needs a consent/response
// handshake on BOTH sides: the booker consents to their booking being used
// this way (Booking.companionTaggingConsent), and the tagged person must
// separately ACCEPT before the tag counts toward anything about *them*
// (Verified/Repeat Attendee counts, Scene Status) - a booker tagging
// someone shouldn't unilaterally attach reputation data to another
// person's account. PENDING tags are inert everywhere except the tagged
// user's own "you've been tagged" inbox.
//
// Phase 2 (per-seat check-in, step 6, not yet built) is the actual
// physical-attendance verification layer this feeds into - this phase is
// only the social capture + consent step, not verification.
model CompanionTag {
  id             String             @id @default(cuid())
  bookingId      String
  booking        Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  taggedByUserId String
  taggedBy       User               @relation("CompanionTagTagger", fields: [taggedByUserId], references: [id])
  taggedUserId   String
  taggedUser     User               @relation("CompanionTagTagged", fields: [taggedUserId], references: [id])
  status         CompanionTagStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  respondedAt    DateTime?

  // Phase 2 (per-seat/per-attendee check-in, step 6). Deliberately
  // separate from Booking.checkedInAt - the booker's own scan checks in
  // the booking as a whole (unchanged, EPIC N), while each ACCEPTED
  // companion is checked in individually at the door. Only meaningful
  // once status is ACCEPTED - enforced at the API level, not the schema.
  //
  // No physical seat-to-companion mapping exists (checkout never
  // collects "which seat is X sitting in"), so this is genuinely
  // per-attendee check-in, not per-physical-seat matching - flagging
  // that distinction explicitly since the build-order item is titled
  // "per-seat check-in" but the data model doesn't support literal
  // seat assignment without a much larger checkout change.
  checkedInAt       DateTime?
  checkedInByUserId String?

  @@unique([bookingId, taggedUserId])
  @@index([taggedUserId, status])
}

enum CompanionTagStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Manual-transfer payout ledger (added 28 Jul, replacing the Route
// auto-split premise from PR #256 - see design doc §4.5 correction).
// One row per confirmed Booking. amountOwed is a snapshot of
// booking.subtotalAmount taken at creation time, not a live read -
// if the booking amount were ever corrected later, historical payout
// obligations shouldn't silently shift underneath an already-reviewed
// ledger. financialYear is denormalized (computed at write time, Indian
// FY = April-March, e.g. "2026-27") purely so the Section 194-O
// cumulative-paid-per-organiser-per-year threshold check is a fast
// indexed query instead of a date-range scan over every ledger row.
//
// Nothing writes to this table yet - schema exists ahead of the
// feature per the standing principle of not retrofitting compliance
// fields after real money rows already exist.
model OrganiserPayoutLedger {
  id           String              @id @default(cuid())
  organiserId  String
  organiser    Organiser           @relation(fields: [organiserId], references: [id])
  bookingId    String              @unique
  booking      Booking             @relation(fields: [bookingId], references: [id])
  eventId      String
  amountOwed   Float
  financialYear String
  status       OrganiserPayoutStatus @default(OWED)
  paidAt       DateTime?
  payoutReference String?
  createdAt    DateTime            @default(now())

  @@index([organiserId, financialYear])
  @@index([status])
}

enum OrganiserPayoutStatus {
  OWED
  PAID
}

// Checkpoint 2 — one Payment per Booking. Kept as a separate table (not
// fields on Booking) so future flows (tips, subscriptions, refunds) can
// attach payments without conflating them with tickets.
//
// `amount` is stored in PAISE (integer), never rupees (float). Razorpay
// itself uses paise, and floats accumulate rounding errors on totals.
model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  verifiedAt        DateTime?
  webhookReceivedAt DateTime?
  failureReason     String?

  // Checkpoint 3 — ticket delivery tracking.
  // @deprecated — source of truth moved to Booking.deliveredAt /
  // Booking.deliveryError in the 20260714 migration so free events
  // (which have no Payment row) can be tracked by the same claim.
  // Kept nullable for historical rows' audit trail. Do NOT read or
  // write from application code. Safe to drop in a future cleanup.
  deliveredAt       DateTime?
  deliveryError     String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([razorpayOrderId])
}

model Review {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id])
  performanceId String?
  performance   Performance? @relation(fields: [performanceId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime     @default(now())

  reply ReviewReply?
}

// Owner-only reply to a Review, one level deep (no threaded discussion).
// "Owner" mirrors the existing review-notification logic in
// POST /api/reviews: a performance-specific review's owner is that
// Artist; a general event review's owner is the event's Organiser. No
// direct Review->Venue link exists in the schema, so Venue Owners can't
// reply yet - same limitation the notification logic already has.
// reviewId is @unique specifically to enforce "one reply per review".
model ReviewReply {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())
}

enum DiaryStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// Free-form admin log for company/legal/administrative milestones
// (registration, PAN, GST, current account, CA sign-offs, etc.) - kept
// separate from Feedback (product bugs/ideas) and design.md (product/
// engineering decisions). Admin-only, no user-facing surface.
model AdminDiaryEntry {
  id        String      @id @default(cuid())
  title     String
  notes     String?
  status    DiaryStatus @default(PENDING)
  createdBy String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

